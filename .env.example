# Copy to .env for local builds, and set the same values in Netlify → Site configuration → Environment variables.
# Never commit real values.

# Quote form delivery (server-side only). With nothing set, leads go through FormSubmit.co
# to finaltouchfencing@gmail.com once that inbox clicks FormSubmit's one-time "Activate Form" email.
QUOTE_TO_EMAIL=finaltouchfencing@gmail.com
# Optional: the random alias FormSubmit emails after activation (hides the address from FormSubmit URLs)
FORMSUBMIT_ALIAS=
# Optional: switch to Resend (branded HTML email) once finaltouchfencing.com is verified there
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Final Touch Fencing Website <quotes@finaltouchfencing.com>"

# Optional: Cloudflare Turnstile spam protection (both must be set together)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Google Tag Manager container (GA4, Google Ads, Meta Pixel are configured inside GTM)
PUBLIC_GTM_ID=
