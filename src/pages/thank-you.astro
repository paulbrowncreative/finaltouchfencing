---
import Simple from '../layouts/Simple.astro';
import { site } from '../data/site.js';
---
<Simple title="Quote Request Received | Final Touch Fencing" h1="Thank you! Your quote request has been received." label="Thank you" path="/thank-you/" description="Your quote request was received." noindex lede="Final Touch Fencing will be in touch soon.">
  <p>If your project is time-sensitive, call us at <a href={site.phoneHref} data-track="phone">{site.phone}</a>.</p>
  <p>While you wait, see whether your city requires a permit in our <a href="/blog/fence-permit-rules-macomb-county/">local fence permit guide</a>, or browse <a href="/our-work/">our work</a>.</p>
</Simple>
