---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReviewList from '../components/ReviewList.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { site } from '../data/site.js';
import { reviewSummary } from '../data/reviews.js';

const title = 'Final Touch Fencing Reviews | 5.0 Stars on Yelp';
const description = 'Read what customers say about Final Touch Fencing: competitive prices, fast estimates and helpful owners. 5.0 stars from 4 reviews on Yelp.';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Reviews', href: '/reviews/' }];
---
<Base title={title} description={description} breadcrumbs={crumbs}>
  <PageHero eyebrow="Reviews" title="What our customers say" crumbs={crumbs} ctaHref="/contact/">
    <p class="lede"><span class="stars" aria-hidden="true">★★★★★</span> {reviewSummary.average.toFixed(1)} out of 5 from {reviewSummary.count} reviews on Yelp</p>
  </PageHero>
  <section class="section">
    <div class="container">
      <ReviewList />
      <p class="notice mt-7">Reviews are shown as they appear publicly on Yelp. Longer reviews are cut off where Yelp’s preview ends; <a href={site.profiles.yelp} rel="noopener" target="_blank">read the full reviews on Yelp<span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
    </div>
  </section>
  <section class="section section--paper" aria-labelledby="leave-h">
    <div class="container container--narrow">
      <h2 id="leave-h">Had us build your fence?</h2>
      <p>A short review helps other homeowners find a contractor they can trust. Thank you!</p>
      <div class="btn-row">
        <a class="btn" href={site.profiles.yelp} rel="noopener" target="_blank" data-cta="review_yelp">Review us on Yelp</a>
        <a class="btn btn--ghost" href={site.profiles.facebook} rel="noopener" target="_blank" data-cta="review_facebook">Recommend us on Facebook</a>
      </div>
    </div>
  </section>
  <QuoteBand />
</Base>
