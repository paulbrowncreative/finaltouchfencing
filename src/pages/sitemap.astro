---
// Human-readable sitemap: every indexable page, grouped by section, linked from the footer.
// Search engines read the XML version (/sitemap-index.xml, generated by @astrojs/sitemap).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { services } from '../data/services.js';
import { areas } from '../data/areas.js';
import { getPosts, CATEGORIES } from '../lib/blog.js';
import { titleCase } from '../lib/titlecase.js';

const title = 'Sitemap | Final Touch Fencing';
const description = 'Every page on the Final Touch Fencing website: fence services, service areas in Macomb County and Metro Detroit, fence guides, reviews and contact.';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Sitemap', href: '/sitemap/' }];
const posts = await getPosts();

const groups = [
  {
    id: 'main',
    title: 'Main Pages',
    links: [
      ['/', 'Home'],
      ['/services/', 'Fence Services'],
      ['/service-areas/', 'Service Areas'],
      ['/our-work/', 'Our Work'],
      ['/reviews/', 'Reviews'],
      ['/about/', 'About Us'],
      ['/blog/', 'Fence Blog'],
      ['/contact/', 'Get a Free Quote'],
    ],
  },
  { id: 'services', title: 'Fence Services', links: services.map((s) => [`/services/${s.slug}/`, s.name]) },
  { id: 'areas', title: 'Service Areas', links: areas.map((a) => [`/service-areas/${a.slug}/`, `Fence Company in ${a.name}`]) },
  ...CATEGORIES.map((c) => ({
    id: c.toLowerCase().replace(/[^a-z]+/g, '-'),
    title: `Fence Guides: ${c}`,
    links: posts.filter((p) => p.data.category === c).map((p) => [`/blog/${p.id}/`, titleCase(p.data.title)]),
  })).filter((g) => g.links.length),
  {
    id: 'company',
    title: 'Policies',
    links: [
      ['/privacy/', 'Privacy Policy'],
      ['/terms/', 'Terms of Use'],
      ['/accessibility/', 'Accessibility'],
    ],
  },
];
---
<Base title={title} description={description} breadcrumbs={crumbs}>
  <PageHero eyebrow="Sitemap" title="Every Page on Our Site" lede="Find any service, service area or fence guide in one place." crumbs={crumbs} showCtas={false} />
  <section class="section">
    <div class="container sitemap">
      {groups.map((g) => (
        <section class="sitemap__group" aria-labelledby={`sm-${g.id}`}>
          <h2 id={`sm-${g.id}`} class="h3">{g.title}</h2>
          <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </section>
      ))}
    </div>
  </section>
</Base>
