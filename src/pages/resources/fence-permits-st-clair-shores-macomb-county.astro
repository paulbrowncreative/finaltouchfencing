    <table class="rules-table">
      <caption>Residential fence rules by community</caption>
      <thead>
        <tr><th scope="col">Community</th><th scope="col">Side / rear max</th><th scope="col">Front yard</th><th scope="col">Permit</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row"><a href="/service-areas/st-clair-shores/">St. Clair Shores</a></th><td>6′6″ privacy (6′ panels)</td><td>Not past the face of the house without Board of Fence Arbitration consent</td><td>Yes, $100 residential; post-hole + final inspection</td></tr>
        <tr><th scope="row"><a href="/service-areas/chesterfield-township/">Chesterfield Twp.</a></th><td>3′–6′</td><td>Split rail only, 24″–42″</td><td>Yes, $65; electronic applications only</td></tr>
