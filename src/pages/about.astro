---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import ReviewList from '../components/ReviewList.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { photos } from '../data/photos.js';
import { site } from '../data/site.js';

const title = 'About Final Touch Fencing | Family-Owned, St. Clair Shores MI';
const description = 'Final Touch Fencing is a family-owned fence company run by Robert and Marisa, started in Clay Township and now based in St. Clair Shores, MI.';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }];
---
<Base title={title} description={description} breadcrumbs={crumbs}>
  <PageHero
    eyebrow="About us"
    title="A family-owned fence company, run by the people you talk to"
    lede="Final Touch Fencing is run by Robert and Marisa. We started out in Clay Township, near Algonac, and we’re now based in St. Clair Shores."
    crumbs={crumbs}
    photo={photos.sideYardDog}
    ctaHref="/contact/"
  />

  <section class="section">
    <div class="container split split--wide-left">
      <div class="prose">
        <h2>What we set out to do</h2>
        <p>Our philosophy is simple: <strong>high-quality fences shouldn’t cost a fortune.</strong> We build fences that are reliable, durable and good-looking, tailored to your yard, without the high price tag.</p>
        <p>Our mission, in our own words: <em>“It is our mission to provide excellent workmanship and complete customer satisfaction, from the start to the completion of a project. … Our reputation is based on service, safety, and quality, regardless of how large or small the job is.”</em></p>

        <h2>How we work</h2>
        <ul>
          <li><strong>We answer questions.</strong> Customers mention Robert and Marisa by name for being helpful through the whole process.</li>
          <li><strong>We price it honestly.</strong> Free, written, no-obligation estimates, and one reviewer who compared four quotes called ours the best price.</li>
          <li><strong>We plan for your city’s rules.</strong> Fence ordinances in St. Clair Shores, Chesterfield, Harper Woods and Macomb Township differ on height, front yards, corner lots and waterfront lots. We check before we build. See our <a href="/resources/fence-permits-st-clair-shores-macomb-county/">permit guide</a>.</li>
          <li><strong>We build the whole job.</strong> Posts, rails, boards or panels, gates and hardware, plus <a href="/services/fence-repair/">repairs</a> and <a href="/services/fence-staining/">staining</a> later on.</li>
        </ul>

        <h2>Good to know</h2>
        <ul>
          <li>Family-owned and operated</li>
          <li>Insured</li>
          <li>Owner background-checked (verified on Thumbtack)</li>
          <li>Warranty available. Ask about coverage at your estimate</li>
          <li>We accept cash, check, credit card, Venmo and Cash App</li>
        </ul>
      </div>
      <div class="stack">
        <Photo photo={photos.shadowGate} sizes="(min-width: 60rem) 40vw, 100vw" />
        <Photo photo={photos.splitRail} sizes="(min-width: 60rem) 40vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="about-reviews-h">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Reviews</span><h2 id="about-reviews-h">In our customers’ words</h2></div>
      <ReviewList />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <h2>Find us online</h2>
      <ul class="chip-list mt-6">
        <li><a href={site.profiles.yelp} rel="noopener" target="_blank">Yelp</a></li>
        <li><a href={site.profiles.facebook} rel="noopener" target="_blank">Facebook</a></li>
        <li><a href={site.profiles.thumbtack} rel="noopener" target="_blank">Thumbtack</a></li>
        <li><a href={site.profiles.angi} rel="noopener" target="_blank">Angi</a></li>
        <li><a href={site.profiles.homeadvisor} rel="noopener" target="_blank">HomeAdvisor</a></li>
      </ul>
    </div>
  </section>
  <QuoteBand />
</Base>
