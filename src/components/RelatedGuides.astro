---
import PostCard from './PostCard.astro';
interface Props { posts: any[]; heading?: string; id?: string }
const { posts, heading = 'Related guides', id = 'guides' } = Astro.props;
---
{posts.length > 0 && (
  <section class="section section--tight" aria-labelledby={`${id}-h`}>
    <div class="container">
      <div class="section-head"><span class="eyebrow">From the blog</span><h2 id={`${id}-h`}>{heading}</h2></div>
      <div class="post-grid">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
      <p class="mt-6"><a class="text-link" href="/blog/">See All Fence Guides</a></p>
    </div>
  </section>
)}
