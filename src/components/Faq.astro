---
interface Props { faqs: { q: string; a: string }[]; heading?: string; id?: string }
const { faqs, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---
<section class="section section--paper" aria-labelledby={`${id}-h`}>
  <div class="container">
    <div class="section-head"><span class="eyebrow">FAQ</span><h2 id={`${id}-h`}>{heading}</h2></div>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="faq__a"><p set:html={f.a} /></div>
        </details>
      ))}
    </div>
  </div>
</section>
