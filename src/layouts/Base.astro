---
import '../styles/global.css';
import archivoWoff from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import publicSansWoff from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site.js';
import { businessNode, websiteNode, webPageNode, breadcrumbNode } from '../lib/schema.js';

interface Crumb { label: string; href: string }
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  schema?: object[];
  preloadImage?: { srcset: string; sizes: string; type: string };
}
const { title, description, ogImage = '/og-default.jpg', ogType = 'website', noindex = false, breadcrumbs, schema = [], preloadImage } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const graph = [
  businessNode(),
  websiteNode(),
  webPageNode({ path, title, description }),
  ...(breadcrumbs ? [breadcrumbNode(breadcrumbs)] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#202428" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href={archivoWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={publicSansWoff} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} fetchpriority="high" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={jsonLd} />

    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) { w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s); j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i; f.parentNode.insertBefore(j, f); })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
