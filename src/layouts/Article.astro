---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { articles, articleBySlug } from '../data/articles.js';
import { articleNode } from '../lib/schema.js';
interface Props { slug: string }
const a = articleBySlug[Astro.props.slug];
const path = `/resources/${a.slug}/`;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Resources', href: '/resources/' }, { label: a.navTitle, href: path }];
const others = articles.filter((x) => x.slug !== a.slug);
const date = new Date(a.published + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title={a.seoTitle} description={a.description} ogType="article" breadcrumbs={crumbs} schema={[articleNode({ path, title: a.title, description: a.description, datePublished: a.published })]}>
  <section class="page-hero page-hero--plain on-dark">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-hero__grid" style="grid-template-columns:1fr">
        <div>
          <h1><span class="eyebrow">Resources</span>{a.title}</h1>
          <p class="lede">{a.summary}</p>
          <p class="article-meta">By Final Touch Fencing · Updated <time datetime={a.published}>{date}</time></p>
        </div>
      </div>
    </div>
  </section>
  <section class="section" data-track-scroll>
    <div class="container content-grid">
      <article class="prose"><slot /></article>
      <aside class="content-grid__aside" aria-label="Related">
        <div class="aside-card">
          <h2>Planning a fence?</h2>
          <p>We check the rules for your address as part of every free estimate.</p>
          <a class="btn btn--lg" href="#quote" data-cta="article_quote">Get a Free Quote</a>
          <ul>
            {others.map((o) => <li><a href={`/resources/${o.slug}/`}>{o.navTitle}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>
  <QuoteBand />
</Base>
